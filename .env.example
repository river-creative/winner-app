# MinistryPlatform API Credentials (optional - only needed for MP import functionality)
# Get these from your MinistryPlatform administrator
MP_USERNAME=your-mp-username
MP_PASSWORD=your-mp-password

# EZ Texting API Credentials (optional - only needed for SMS functionality)
# Get these from your EZ Texting account at https://app.eztexting.com/
EZ_TEXTING_USERNAME=your-email@example.com
EZ_TEXTING_PASSWORD=your-api-key-or-password

# Server Configuration (optional - defaults shown)
# PORT=3001

# Admin Authentication (REQUIRED — the server refuses to start without these)
# The shared operator credentials behind "Sign in with admin credentials" on the login page.
# Kept deliberately as a backdoor: prize-scanner volunteers have no Workspace account, and this
# is the way back in if Google is unreachable.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Google Sign-In (REQUIRED — the server refuses to start without these)
# Restricts the primary login path to one Google Workspace domain. The client ID is NOT a secret
# (the browser sends it in the clear) — it is the OAuth audience every ID token is verified
# against. It lives here so the value can differ per deployment without a rebuild.
#
# The client ID must have this app's origins listed under "Authorized JavaScript origins" in
# Google Cloud Console, or the sign-in button renders and then refuses every attempt:
#   https://win.revival.com, http://localhost:3000, http://localhost:3001
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_HOSTED_DOMAIN=revival.com