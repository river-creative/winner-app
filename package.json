{
  "name": "winner-app",
  "version": "2.0.0",
  "description": "River Winner App — SvelteKit 5 frontend on an Express/JSON backend",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:server": "nodemon --exec tsx backend/server.ts",
    "dev:all": "concurrently -k -n server,web -c blue,green \"npm run dev:server\" \"npm run dev\"",
    "build": "vite build && tsc -p tsconfig.backend.json",
    "build:frontend": "vite build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "preview": "vite preview",
    "server": "node backend/server.js",
    "start": "npm run build && npm run server",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riveruniversity/winner-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/riveruniversity/winner-app/issues"
  },
  "homepage": "https://github.com/riveruniversity/winner-app#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.20.1",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.1.0",
    "mp-js-api": "^0.0.30",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "qr-scanner": "^1.4.2",
    "uuid": "^9.0.1",
    "zxing-wasm": "^3.1.3"
  }
}
