node_modules
.pnpm-store/
data/*
!data/mp.json
dist/

.env

# Local Netlify folder
.netlify
package-lock.json
nul

# Backend compiled JavaScript files
backend/*.js
backend/**/*.js
backend/**/*.map
# Keep TypeScript files
!backend/*.ts
!backend/**/*.ts

# SvelteKit build output. The app moved to the repo root in the Svelte 5 migration, so these are
# root-level now; `dist/` above is where adapter-static writes the site Express serves.
.svelte-kit/
build/

# Backup payloads: ignored by default, because a populated one carries participants' names,
# emails, phones and dates of birth, and this repo is on GitHub. Naming one explicitly is a
# deliberate act — see backups/README.md for the screening rule.
backups/*
!backups/README.md
!backups/2026-09-10-fresh-start-config.json
